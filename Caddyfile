# Static file server for the built SPA.
#
# This container serves assets only; the edge proxy in artha-platform handles
# TLS and routes /api to the backend. Keeping them separate means each
# repository builds and versions its own artifact.

:80 {
	root * /srv
	encode zstd gzip

	# Hashed asset filenames are immutable, so they can be cached forever.
	# index.html must not be, or a deploy is invisible until caches expire.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	# Single-page app: unknown paths are client-side routes, not 404s.
	try_files {path} /index.html
	file_server
}
